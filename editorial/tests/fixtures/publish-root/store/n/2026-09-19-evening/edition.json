itution":true,"allow_role_fallback":true,"omittable_story_ids":["maribo-suspected-arson","electricity-near-zero-saturday"],"reserve_story_ids":[]},"inputs":[{"id":"export-2026-09-19-1949","sha256":"sha256:9bb5391b87748567dcb149a79b3eb0cdb8699e073c2cc49b0301ec1a4a5dbe64"}],"presentation":{"ear_right":"Inside: Trump plans an AI force, 48 killed in Yemen fighting, Denmark wins in Davis Cup","emphasis":"one_big_story","preferred_composition":"lead-wide"},"schema_version":1,"stories":[{"callouts":[],"copy":{"body":{"extended":[{"sources":["kristeligt_dagblad","altinget","borsen"],"text":"Denmark, Greenland and the United States have negotiated a security agreement expected to be signed during next week's UN General Assembly in New York. Mette Frederiksen says it recognises the Kingdom of Denmark's sovereignty and territorial integrity, and Greenlanders' right to self-determination."},{"sources":["politiken","dr","kristeligt_dagblad"],"text":"Donald Trump says the agreement gives the US 'permanent control' over security in Greenland, permits a larger American military presence and prevents other countries from making agreements with Greenland without written US approval. The text has not been published, and the Danish and Greenlandic governments have not confirmed those details."},{"sources":["berlingske","kristeligt_dagblad"],"text":"Greenlandic MP Naaja Nathanielsen says the reported protection of sovereignty and self-determination means red lines have not been crossed. Marc Jacobsen of the Royal Danish Defence College says the 1951 arrangement already gave the US broad military access; the cost, timing and NATO's role remain unknown."}],"short":[{"sources":["kristeligt_dagblad","altinget","politiken"],"text":"Denmark, Greenland and the United States have negotiated an Arctic security agreement expected to be signed next week. The governments stress sovereignty and self-determination; the unpublished text leaves Trump's broader claims unconfirmed."}],"standard":[{"sources":["kristeligt_dagblad","altinget","borsen"],"text":"Denmark, Greenland and the United States have negotiated a security agreement expected to be signed during next week's UN General Assembly in New York. Mette Frederiksen says it recognises the Kingdom of Denmark's sovereignty and territorial integrity, and Greenlanders' right to self-determination."},{"sources":["politiken","dr","kristeligt_dagblad"],"text":"Donald Trump says the agreement gives the US 'permanent control' over security in Greenland and permits a larger American military presence. The text has not been published, and the Danish and Greenlandic governments have not confirmed his detailed claims."},{"sources":["berlingske","kristeligt_dagblad"],"text":"Greenlandic MP Naaja Nathanielsen says the reported protection of sovereignty and self-determination means red lines have not been crossed. The agreement's cost, timing and NATO's role remain unknown."}]},"deck":"The text remains unpublished; signing is expected next week as Trump claims permanent control and the governments stress sovereignty.","headline":"Denmark, Greenland and US reach Arctic security agreement","headline_short":"Arctic security agreement reached"},"device_participation":"required","id":"greenland-us-security-agreement","kicker":"Defence","limitations":["digest_of_rss_description","translated_from_source_language"],"role":"lead","sources":[{"content_hash":"sha256:cae4364cb727929876f8dc9a7764d5a433ce2955bd0ba59a9cdf48d42ac68fd8","input_id":"export-2026-09-19-1949","original_title":"Ifølge Trump skal USA godkende alle andre landes aftaler med Grønland. Er det sandsynligt? Her er, hvad vi ved om den nye Grønland-aftale","primary":true,"published_at":"2026-09-19T11:20:00.000000Z","source":"kristeligt_dagblad","source_id":"6727fc99-a010-4e2f-8226-575e0e55a807","url":"https://www.kristeligt-dagblad.dk/udland/ifoelge-trump-skal-usa-godkende-alle-andres-aftaler-med-groenland-er-det-sandsynligt-her-er"},{"content_hash":"sha256:7c9985079321