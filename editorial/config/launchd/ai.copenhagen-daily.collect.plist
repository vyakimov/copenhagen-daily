<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.copenhagen-daily.collect</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>/Users/vy/Documents/Development/news-gatherer/ingest/gather_news.sh collect --once; exit $?</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/vy</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/vy/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>HOME</key>
		<string>/Users/vy</string>
		<key>PUBLISHER_MAGICK</key>
		<string>/opt/homebrew/bin/magick</string>
	</dict>
	<key>StartInterval</key>
