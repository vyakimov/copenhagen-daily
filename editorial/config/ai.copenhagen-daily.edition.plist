<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The morning edition on macOS. Copy to ~/Library/LaunchAgents/, replace REPO with the absolute
     repository path, then `launchctl load ~/Library/LaunchAgents/ai.copenhagen-daily.edition.plist`.
     The hour and minute are local time and should sit a few minutes after the policy's cutoff. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.copenhagen-daily.edition</string>
	<key>ProgramArguments</key>
	<array>
		<string>REPO/editorial/edit_news.sh</string>
		<string>run</string>
	</array>
	<key>WorkingDirectory</key>
	<string>REPO</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/vy/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>PUBLISHER_MAGICK</key>
		<string>/opt/homebrew/bin/magick</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>5</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>REPO/editorial/var/edition.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>REPO/editorial/var/edition.stderr.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
