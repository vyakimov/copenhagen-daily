---
import { config } from "../lib.ts";
const { title = "Copenhagen Daily", language = "en", redirect } = Astro.props;
const stylesheet = `/a/${config.layout_version}/web.css`;
const csp = [
  "default-src 'none'", "style-src 'self'", "font-src 'self'", "img-src 'self'",
  "base-uri 'none'", "form-action 'none'",
].join("; ");
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta name="robots" content="noindex, nofollow, noarchive, noimageindex">
    <meta http-equiv="Content-Security-Policy" content={csp}>
    {redirect && <meta http-equiv="refresh" content={`0;url=${redirect}`} />}
    <link rel="stylesheet" href={stylesheet}>
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
