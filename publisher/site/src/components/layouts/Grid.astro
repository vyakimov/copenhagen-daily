---
// Grid composition: the lead beside a rail of up to two secondaries, then the remaining stories flow
// through three balanced columns, secondaries before briefs. Contract order is kept within each role.
import Story from "../Story.astro";
const { lead, secondaries, briefs, common } = Astro.props;
const rail = secondaries.slice(0, 2);
const flow = secondaries.slice(2);
---
<div class:list={["grid", "top", { alone: rail.length === 0 }]}>
  <Story story={lead} {...common} twoColumn={true} />
  {rail.length > 0 && <div class="rail">{rail.map((s: any) => <Story story={s} {...common} />)}</div>}
</div>
{(flow.length > 0 || briefs.length > 0) && (
  <>
    <div class="ornament" aria-hidden="true">❦</div>
    <div class="flow">
      {flow.map((s: any) => <Story story={s} {...common} />)}
      {briefs.length > 0 && <div class="head">Also today</div>}
      {briefs.map((s: any) => <Story story={s} {...common} />)}
    </div>
  </>
)}
