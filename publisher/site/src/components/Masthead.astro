---
import { formatCutoff, formatEditionDate } from "../../../assets/html/format.ts";
// The masthead, the ruled dateline, and the navigation line. Prev/next go through the shell-owned
// go/ stubs so an archived page never needs rewriting when a newer edition arrives.
const { edition, masthead, earRight, publishers, device } = Astro.props;
const cutoff = formatCutoff(edition.cutoff_at, edition.language, edition.timezone);
const date = formatEditionDate(edition.date, edition.language);
---
<header class="masthead">
  <div class="ear"><span class="lbl">{edition.name}</span><br />News through {cutoff}</div>
  <div class="title">{masthead}</div>
  <div class="ear right">{earRight ?? `Edition ${edition.number}`}</div>
</header>
<div class="dateline">
  <span><time datetime={edition.date}>{date}</time></span>
  <span class="mid">No. {edition.number}</span>
  <span>{publishers.join(" · ")}</span>
</div>
<nav class="editions" aria-label="Edition navigation">
  <a href={`/go/${edition.id}/prev/`}>← Previous edition</a>
  <span>
    <a href="/archive/">Edition archive</a>
    {device && <span class="device-note"> · <a href="./device/page-1.png">View as printed page (1872 × 1404)</a></span>}
  </span>
  <a href={`/go/${edition.id}/next/`}>Next edition →</a>
</nav>
