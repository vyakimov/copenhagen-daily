---
import Masthead from "./Masthead.astro";
import Grid from "./layouts/Grid.astro";
import Sheet from "./layouts/Sheet.astro";
import { formatEditionDate } from "../../../assets/html/format.ts";
import { sourceName, storyCredits } from "../../../assets/html/credit.ts";
const { edition, config } = Astro.props;
const meta = edition.edition;
const names = { publishers: config.publishers, agencies: config.agencies ?? {} };
const common = { ...names, language: meta.language, timezone: meta.timezone };

// The composition is a title-level choice (config/title.yaml, web_layout). Both compositions render the
// same Story component and share one type scale, so switching is one word and nothing drifts.
const layouts = { grid: Grid, sheet: Sheet } as const;
const layout: keyof typeof layouts = config.web_layout in layouts ? config.web_layout : "grid";
const Layout = layouts[layout];
const stories: any[] = edition.stories;
const roles = {
  lead: stories.find((s) => s.role === "lead"),
  secondaries: stories.filter((s) => s.role === "secondary"),
  briefs: stories.filter((s) => s.role === "brief"),
};
// The dateline names the publishers that contributed to the most stories, as many as fit in about a
// date's length (DATELINE_NAME_CHARS, always at least one), and counts the rest, so the edition number
// between them stays centred. Stories rather than articles, so a wire-heavy outlet cannot climb the line by volume.
// Each story's source row still names its own publishers in full. Wire copy counts for its agency,
// as it does in the source row.
const storiesBy = new Map<string, number>();
const articlesBy = new Map<string, number>();
for (const s of stories) {
  for (const name of storyCredits(s.sources, names)) storiesBy.set(name, (storiesBy.get(name) ?? 0) + 1);
  for (const x of s.sources) {
    const name = sourceName(x, names);
    articlesBy.set(name, (articlesBy.get(name) ?? 0) + 1);
  }
}
const ranked = [...storiesBy.keys()].sort(
  (a, b) => storiesBy.get(b)! - storiesBy.get(a)! || articlesBy.get(b)! - articlesBy.get(a)! || a.localeCompare(b),
);
const DATELINE_NAME_CHARS = 30;
let shown = 1;
while (shown < ranked.length && ranked.slice(0, shown + 1).join(" · ").length <= DATELINE_NAME_CHARS) shown++;
const leading = { names: ranked.slice(0, shown), others: Math.max(0, ranked.length - shown) };
---
<main class:list={["page", `layout-${layout}`]}>
  <Masthead edition={meta} masthead={config.masthead} earRight={edition.presentation?.ear_right}
    leading={leading} />
  <Layout {...roles} common={common} />

  <div class="coverage">
    <span class="t">About this edition</span> Coverage {edition.coverage.status}. {edition.coverage.note}
  </div>
  <footer class="folio">
    <span>Edition <b>{meta.id}</b> · {formatEditionDate(meta.date, meta.language)}</span>
    <span>{config.masthead} is not affiliated with any publisher listed.{config.contact && (
      <> Write to <a href={`mailto:${config.contact}`}>{config.contact}</a>.</>
    )}</span>
  </footer>
</main>
