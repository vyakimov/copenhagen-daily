---
import Broadsheet from "../../layouts/Broadsheet.astro";
import { config, order } from "../../lib.ts";
import { formatEditionDate } from "../../../../assets/html/format.ts";
---
<Broadsheet title={`Archive — ${config.masthead}`}>
  <main class="page">
    <div class="title">{config.masthead}</div>
    <div class="dateline">
      <span>Edition archive</span><span class="mid">{order.length} editions</span><span></span>
    </div>
    <ol class="archive-list" reversed>
      {[...order].reverse().map((e) => (
        <li>
          <a href={`/n/${e.id}/`}>{formatEditionDate(e.date, e.language)}</a> <span>· {e.name}</span>
        </li>
      ))}
    </ol>
    <a href="/">Latest edition</a>
  </main>
</Broadsheet>
