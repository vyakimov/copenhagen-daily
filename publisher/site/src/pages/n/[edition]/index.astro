---
import Broadsheet from "../../../layouts/Broadsheet.astro";
import Edition from "../../../components/Edition.astro";
import { config, order } from "../../../lib.ts";
import { getCollection } from "astro:content";
export async function getStaticPaths() {
  const entries = await getCollection("editions");
  return entries.map((entry) => ({ params: { edition: entry.data.edition.id }, props: { edition: entry.data } }));
}
const { edition } = Astro.props;
const position = order.findIndex((x) => x.id === edition.edition.id);
const entry = order[position];
---
<Broadsheet title={`${edition.edition.name} — ${config.masthead}`} language={edition.edition.language}>
  <Edition edition={edition} config={config} previous={position > 0} next={position + 1 < order.length}
    device={entry?.device_status === "published"} />
</Broadsheet>
