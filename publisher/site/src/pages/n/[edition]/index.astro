---
import Broadsheet from "../../../layouts/Broadsheet.astro";
import Edition from "../../../components/Edition.astro";
import { config } from "../../../lib.ts";
import { getCollection } from "astro:content";
export async function getStaticPaths() {
  const entries = await getCollection("editions");
  return entries.map((entry) => ({ params: { edition: entry.data.edition.id }, props: { edition: entry.data } }));
}
const { edition } = Astro.props;
---
<Broadsheet title={`${edition.edition.name} — ${config.masthead}`} language={edition.edition.language}>
  <Edition edition={edition} config={config} />
</Broadsheet>
