      "id": "harbour-tunnel-vote",
      "device_participation": "required",
      "role": "lead",
      "kicker": "Copenhagen",
      "copy": {
        "headline": "Council backs harbour tunnel after night-long sitting",
        "headline_short": "Council backs harbour tunnel",
        "deck": "A 29 to 26 vote sends the eastern ring road to the state for financing, with the mayor calling it the decision of a generation.",
        "body": {
          "extended": [
            {
              "text": "Copenhagen's city council voted 29 to 26 early on Tuesday to back the eastern harbour tunnel, ending a debate that ran past two in the morning.",
              "sources": [
                "politiken"
              ]
            },
            {
              "text": "The mayor described the vote as the decision of a generation and said the plan now goes to the state for a financing agreement.",
              "sources": [
                "berlingske"
              ]
            },
            {
              "text": "Opponents on the council argued the tunnel would draw more cars into the city and asked for a further environmental review before construction begins.",
              "sources": [
                "dr"
              ]
            }
          ],
          "standard": [
            {
              "text": "Copenhagen's city council voted 29 to 26 early on Tuesday to back the eastern harbour tunnel, ending a debate that ran past two in the morning.",
              "sources": [
                "politiken"
              ]
            },
            {
              "text": "The mayor called it the decision of a generation; opponents want a further environmental review.",
              "sources": [
                "berlingske",
                "dr"
              ]
            }
          ],
          "short": [
            {
              "text": "The council voted 29 to 26 for the eastern harbour tunnel after a sitting that ran past two in the morning.",
              "sources": [
                "politiken"
              ]
            }
          ]
        }
      },
