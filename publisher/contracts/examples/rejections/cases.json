{
 "base": "minimal.json",
 "cases": [
  {
   "name": "unknown-field",
   "invariant": "unknown fields are rejected",
   "ops": [
    {
     "op": "add",
     "path": "/unexpected",
     "value": true
    }
   ],
   "expected_code": "contract_invalid",
   "expected_pointer": "/unexpected"
  },
  {
   "name": "unsupported-schema-version",
   "invariant": "only implemented schema versions are accepted",
   "ops": [
    {
     "op": "replace",
     "path": "/schema_version",
     "value": 3
    }
   ],
   "expected_code": "contract_unsupported_schema_version",
   "expected_pointer": "/schema_version"
  },
  {
   "name": "wire-agency-in-version-1",
   "invariant": "a wire agency on a source belongs to schema version 2",
   "ops": [
    {
     "op": "add",
     "path": "/stories/0/sources/0/wire",
     "value": "ritzau"
    }
   ],
   "expected_code": "contract_invalid",
   "expected_pointer": "/stories/0/sources/0/wire"
  },
  {
   "name": "title-mismatch",
   "invariant": "title must equal the configured title id",
   "ops": [
    {
     "op": "replace",
     "path": "/title",
     "value": "other-title"
    }
   ],
   "expected_code": "contract_invalid",
   "expected_pointer": "/title"
  },
  {
   "name": "timestamp-shape",
   "invariant": "timestamps are RFC 3339 UTC with six fractional digits",
   "ops": [
    {
     "op": "replace",
     "path": "/edition/cutoff_at",
     "value": "2026-09-08T03:00:00Z"
    }
   ],
   "expected_code": "contract_invalid",
   "expected_pointer": "/edition/cutoff_at"
  },
  {
   "name": "calendar-date",
   "invariant": "dates are real calendar dates",
   "ops": [
    {
     "op": "replace",
     "path": "/edition/date",
     "value": "2026-02-30"
    }
   ],
   "expected_code": "contract_invalid",
   "expected_pointer": "/edition/date"
  },
  {
   "name": "duplicate-input",
   "invariant": "input ids are unique",
   "ops": [
    {
     "op": "add",
     "path": "/inputs/1",
     "value": {
      "id": "export-2026-09-08-0300",
      "sha256": "sha256:293a9e5e14222635ff747340a406028c1e49082ea7996676008b3528e10ae33f"
     }
    }
   ],
   "expected_code": "contract_invalid",
   "expected_pointer": "/inputs/1/id"
  },
  {
   "name": "lead-not-first",
   "invariant": "the lead is first",
   "ops": [
    {
     "op": "add",
     "path": "/stories/0",
     "value": {
      "id": "extra-secondary",
      "device_participation": "optional",
      "role": "secondary",
      "fallback_role": "brief",
      "kicker": "Denmark",
      "copy": {
       "headline": "An extra secondary",
       "lede": {
        "text": "An extra item.",
        "sources": []
       },
       "body": {
        "short": [
         {
          "text": "DR reports an extra item.",
          "sources": []
         }
        ]
       }
      },
      "callouts": [],
      "sources": [],
      "limitations": [
       "headline_only"
      ]
     }
    },
    {
     "op": "replace",
     "path": "/fit_policy/omittable_story_ids",
     "value": [
      "extra-secondary"
     ]
    }
   ],
   "expected_code": "contract_invalid",
   "expected_pointer": "/stories/1/role"
  },
  {
   "name": "no-lead",
   "invariant": "exactly one lead",
   "ops": [
    {
     "op": "replace",
     "path": "/stories/0/role",
     "value": "secondary"
    }
   ],
   "expected_code": "contract_invalid",
   "expected_pointer": "/stories"
  },
  {
   "name": "lead-optional",
   "invariant": "the lead is required on the device",
   "ops": [
    {
     "op": "replace",
     "path": "/stories/0/device_participation",
     "value": "optional"
    },
    {
     "op": "replace",
     "path": "/fit_policy/omittable_story_ids",
     "value": [
      "dr-insect-survey-2026-09-07"
     ]
    }
   ],
   "expected_code": "contract_invalid",
   "expected_pointer": "/stories/0/role"
  },
  {
   "name": "brief-fallback",
   "invariant": "only secondary falls back, and only to brief",
   "ops": [
    {
     "op": "add",
     "path": "/stories/1",
     "value": {
      "id": "extra-brief",
      "device_participation": "optional",
      "role": "brief",
