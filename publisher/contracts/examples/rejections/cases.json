       "body": {}
      },
      "callouts": [],
      "sources": [],
      "limitations": [
       "headline_only"
      ],
      "fallback_role": "brief"
     }
    },
    {
     "op": "replace",
     "path": "/fit_policy/omittable_story_ids",
     "value": [
      "extra-brief"
     ]
    }
   ],
   "expected_code": "contract_invalid",
   "expected_pointer": "/stories/1/fallback_role"
  },
  {
