  "stories": [
    {
      "id": "animal-welfare-six-years-new-agency",
      "device_participation": "required",
      "role": "lead",
      "kicker": "Politics",
      "copy": {
        "headline": "Six years in prison for the worst animal-welfare breaches under emergency plan",
        "body": {
          "standard": [
            {
              "text": "The maximum sentence for the most serious breaches of animal-welfare rules rises from two to six years in prison under an emergency plan the government and Alternativet presented on Tuesday. A new agency under the Justice Ministry will take over the inspections, which increase by 50 per cent.",
              "sources": [
                "kristeligt_dagblad",
                "dr",
                "berlingske",
                "jp",
                "tv2"
              ]
            },
            {
              "text": "From 2027 at least two inspectors will attend each visit to pig, cattle and poultry herds, and more than 100 staff will be hired. The plan costs 120 million kroner in 2027, rising to 160 million a year by 2029, and farmers will pay most of it through a higher inspection fee.",
              "sources": [
                "kristeligt_dagblad"
              ]
            },
            {
              "text": "'Now we are cleaning up after decades of failing the animals,' said Franciska Rosenkilde, Alternativet's political leader, who presented the plan at the Justice Ministry.",
              "sources": [
                "kristeligt_dagblad",
                "politiken"
              ]
            },
            {
              "text": "Jeppe Bloch Nielsen, chairman of Danske Svineproducenter, calls the plan a 'media stunt' and says it was the agency, not the farmers, that failed. He puts a producer's fee at about 4,000 kroner today and says the producers' own calculation shows it could reach 19,000.",
              "sources": [
                "kristeligt_dagblad"
              ]
            }
          ]
        },
        "deck": "A new agency will run more inspections, paid for mainly by farmers; pig producers call it a media stunt."
      },
      "callouts": [
        {
          "kind": "figure",
          "value": "6 years",
          "label": "Maximum prison sentence for the most serious animal-welfare breaches, up from two"
        },
        {
          "kind": "quote",
          "text": "Now we are cleaning up after decades of failing the animals.",
          "attribution": "Franciska Rosenkilde, Alternativet's political leader",
          "attribution_source": "kristeligt_dagblad"
        }
      ],
